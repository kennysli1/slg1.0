{
  "name": "slg1.0",
  "private": true,
  "version": "0.0.1",
  "description": "King of World (KOW) - 全栈TypeScript网页SLG",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client",
    "packages/dice-lab"
  ],
  "scripts": {
    "build:shared": "npm run build -w @slg/shared",
    "build:server": "npm run build -w @slg/server",
    "build:client": "npm run build -w @slg/client",
    "build:dice-lab": "npm run build -w @slg/dice-lab",
    "build": "npm run build:shared && npm run build:server && npm run build:client && npm run build:dice-lab",
    "dev:server": "npm run dev -w @slg/server",
    "dev:dice-lab": "npm run dev -w @slg/dice-lab",
    "dev:server:test-01": "PORT=8081 DATA_PATH=./data/test-01/game.json LOG_DIR=./data/test-01/logs npm run dev -w @slg/server",
    "start": "node packages/server/dist/main.js",
    "start:test-01": "PORT=8081 DATA_PATH=./data/test-01/game.json LOG_DIR=./data/test-01/logs node packages/server/dist/main.js",
    "start:dice-lab": "npm run start -w @slg/dice-lab",
    "test:server": "npm run test -w @slg/server",
    "test:dice-lab": "npm run test -w @slg/dice-lab",
    "lint": "npm run lint -w @slg/server",
    "lint:all": "npm run lint -w @slg/server && npm run lint -w @slg/client && npm run lint -w @slg/dice-lab",
    "typecheck": "npm run typecheck -w @slg/client",
    "test:all": "npm run test:server && npm run test:dice-lab && npm run test -w @slg/client",
    "test:deploy": "node scripts/deploy-smoke.mjs && node scripts/dice-lab-smoke.mjs",
    "test:ops": "bash scripts/release-layout.test.sh",
    "verify:config-sync": "node --import tsx scripts/verify-config-sync.mjs",
    "verify:changed": "node scripts/verify-changed.mjs",
    "guard": "node scripts/guard/run.mjs",
    "hooks:install": "node scripts/setup-hooks.mjs",
    "worktree:prepare": "npm ci && npm run hooks:install",
    "prepare": "node scripts/setup-hooks.mjs",
    "release": "node scripts/release.mjs",
    "verify:quick": "npm run build:shared && npm run lint:all && npm run typecheck && npm run test:all",
    "verify:deploy": "npm run build && npm run test:deploy",
    "verify:commit": "node scripts/commit-gate.mjs",
    "deploy:prod": "bash tools/deploy.sh",
    "verify:ci": "npm run guard && npm run verify:quick && npm run test:ops && npm run verify:deploy && npm audit --omit=dev --audit-level=high",
    "verify": "npm run verify:ci",
    "reset:season": "node --import tsx packages/server/src/admin.ts --mode=season",
    "reset:respawn": "node --import tsx packages/server/src/admin.ts --mode=respawn",
    "wipe:all": "node --import tsx packages/server/src/admin.ts --mode=wipe",
    "config:migrate": "node packages/server/dist/infra/config-authority.js --migrate"
  },
  "devDependencies": {
    "ws": "^8.18.0"
  }
}
