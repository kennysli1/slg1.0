#!/bin/sh
# 主分支只通过远程 PR/MR 合并；禁止从本地直接推送 main/master。
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "✖ 禁止直接推送到 ${remote_ref#refs/heads/}，请推送功能分支并创建 PR。" >&2
      exit 1
      ;;
  esac
done

# push 前重复执行无外部副作用的验证，防提交后到推送前环境漂移。配置同步
# 之后 main 中的 CSV 是管理员确认过的运行时事实；仅工具/文档改动走同一套
# 配置结构校验，触及业务代码或 CSV 的提交仍走完整回归。
if git rev-parse --verify origin/main >/dev/null 2>&1 \
  && ! git diff --name-only origin/main...HEAD | grep -qE '^(packages/|config/)'; then
  npm run build:shared \
    && npm run lint:all \
    && npm run typecheck \
    && npm run verify:config-sync \
    && npm run test:ops
else
  npm run verify:quick
fi
