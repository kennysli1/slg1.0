#!/bin/sh
# 主分支只通过远程 PR/MR 合并；禁止从本地直接推送 main/master。
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "✖ 禁止直接推送到 ${remote_ref#refs/heads/}，请推送功能分支并创建 PR。" >&2
      exit 1
      ;;
  esac
done

# 提交验证与不可绕过的 PR CI 已经分别证明当前快照；push 不再重复跑高成本构建/测试。
# --no-verify 也不能绕过远端 CI，push hook 只负责禁止直推主分支。
exit 0
